{
  "name": "dashboard-wa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "fase0:report": "tsx scripts/fase0-report.ts",
    "smoke": "tsx --conditions=react-server scripts/smoke.ts",
    "db:bersihkan": "tsx --conditions=react-server scripts/bersihkan-contoh.ts",
    "fase0:putar-ulang": "tsx --conditions=react-server scripts/putar-ulang.ts",
    "db:reset": "tsx --conditions=react-server scripts/reset-data.ts",
    "staging:migrate": "node scripts/staging.mjs drizzle-kit migrate",
    "staging:seed": "node scripts/staging.mjs tsx src/db/seed.ts",
    "staging:dev": "node scripts/staging.mjs next dev -p 3200 -H 127.0.0.1",
    "staging:gateway": "node scripts/staging.mjs node scripts/gateway-tiruan.mjs",
    "staging:smoke": "node scripts/staging.mjs tsx --conditions=react-server scripts/smoke.ts",
    "staging:up": "docker compose -f docker-compose.staging.yml --env-file .env.staging up -d",
    "staging:psql": "docker exec -it dashboard-wa-staging-db-1 psql -U wa_staging -d dashboard_wa_staging"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "next": "^16.3.2",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
