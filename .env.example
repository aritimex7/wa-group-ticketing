# Copy to .env and fill in. Never commit .env.
# Just want to try the app? You don't need this file: see "Quick start" in README.md.

# ---------------------------------------------------------------- database
POSTGRES_USER=wa
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=dashboard_wa
DATABASE_URL=postgresql://wa:change-me-to-a-long-random-string@localhost:5432/dashboard_wa

# ---------------------------------------------------------------- login sessions
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ---------------------------------------------------------------- WhatsApp gateway
# "evolution" (Evolution API) or "waha". The rest of the app does not care which.
GATEWAY_PROVIDER=evolution
GATEWAY_URL=http://localhost:8080
GATEWAY_API_KEY=change-me
GATEWAY_INSTANCE=main
# URL the gateway uses for media links. Usually the same as GATEWAY_URL.
GATEWAY_PUBLIC_URL=http://localhost:8080
# Where the gateway posts incoming messages. From inside Docker, the app on
# your host is reachable as host.docker.internal.
WEBHOOK_TARGET=http://host.docker.internal:3000/api/webhook/evolution
# Optional shared token. If set, append ?token=... to WEBHOOK_TARGET.
WEBHOOK_TOKEN=

# ---------------------------------------------------------------- your own WhatsApp account
# The number the gateway is logged in with, digits only, e.g. 6281234567890.
# WA_SELF_LID is the same account's LID (see "Connecting a real WhatsApp
# account" in README.md for how to find it).
WA_SELF_PN=
WA_SELF_LID=

# ---------------------------------------------------------------- payload capture
# "on" stores every raw webhook payload in var/raw/*.jsonl so you can check
# your gateway's real message format. Turn it off once the parser is verified.
FASE0_DUMP=on

# ---------------------------------------------------------------- background jobs
# The web process runs the outbox and auto-release every 10 seconds by itself.
# Set to "off" if you prefer an external cron calling /api/cron/tick.
INTERNAL_TICKER=on
# Token for /api/cron/tick (only needed with INTERNAL_TICKER=off).
CRON_TOKEN=

# ---------------------------------------------------------------- access
# Optional IP allowlist (comma separated, single IPs or CIDR). Empty = allow all.
# A second allowlist can be managed by leaders on the Settings page.
ACCESS_IP_ALLOWLIST=
# Number of reverse proxies in front of the app (nginx, Caddy). 0 = none, and
# X-Forwarded-For is ignored. Set to 1 behind a single proxy.
ACCESS_PROXY_HOPS=0

# ---------------------------------------------------------------- sample data
# Initial password for the sample accounts created by `npm run db:seed`.
SEED_PASSWORD=rahasia123
