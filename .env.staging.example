# Environment STAGING. Mesin ini staging; production jalan di VPS lain.
# Salin ke .env.staging lalu isi yang bertanda <isi>. JANGAN commit .env.staging.
#
# Berkas ini TIDAK dibaca Next.js secara otomatis. Next hanya memuat
# .env, .env.local, dan .env.<NODE_ENV>. `.env.staging` bukan salah satunya -
# itu disengaja, supaya `npm run dev` yang biasa tidak mungkin tersedot ke
# staging. Yang memuatnya adalah scripts/staging.mjs, dipanggil lewat
# npm run staging:*.
#
# Semua 20 kunci ditulis lengkap, walau sebagian sama dengan .env. Itu bukan
# kelebihan tulis. dotenv dan @next/env TIDAK menimpa process.env yang sudah
# terisi, jadi kunci yang tidak disebut di sini akan diam-diam jatuh ke nilai
# .env - termasuk GATEWAY_API_KEY yang asli. Daftar lengkap menutup celah itu.

# ---------------------------------------------------------------- database
# Postgres 17-alpine di container, port 5433, terpisah total dari cluster
# native 18.6 di 5432 yang dipakai dashboard_wa.
POSTGRES_USER=wa_staging
POSTGRES_DB=dashboard_wa_staging
STAGING_POSTGRES_PASSWORD=<isi-sandi-panjang>
DATABASE_URL=postgresql://wa_staging:<isi-sandi-panjang>@127.0.0.1:5433/dashboard_wa_staging

# POSTGRES_PASSWORD sengaja dikosongkan. Yang dipakai compose staging adalah
# STAGING_POSTGRES_PASSWORD di atas. Kunci ini ada hanya supaya tidak jatuh
# ke nilai .env kalau ada kode/compose lain yang membacanya.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- sesi login
# Beda dari .env. Akibatnya: cookie sesi staging tidak sah di app lokal port
# 3100 dan sebaliknya. Buka staging di http://127.0.0.1:3200 (bukan
# localhost:3200) - cookie tidak mengenal port, tapi mengenal host, jadi
# 127.0.0.1 dan localhost punya jar terpisah dan dua sesi bisa hidup bersamaan.
AUTH_SECRET=<isi-minimal-32-karakter>

# ---------------------------------------------------------------- gateway
# Staging TIDAK menyentuh gateway sungguhan. Port 8099 ditempati gateway
# TIRUAN (scripts/gateway-tiruan.mjs, jalankan dengan npm run staging:gateway):
# ia menjawab seperti Evolution dan menembak balik webhook ack, jadi alur kirim
# selesai penuh sampai terkonfirmasi - tanpa satu pun pesan keluar ke WhatsApp.
# Kalau tiruan tidak dijalankan, port itu kosong dan kirim gagal keras. Dua-duanya
# aman; yang TIDAK boleh adalah mengarahkan ini ke instance WhatsApp yang asli.
GATEWAY_PROVIDER=evolution
GATEWAY_URL=http://127.0.0.1:8099
GATEWAY_API_KEY=staging-tiruan-bukan-kunci-asli0
GATEWAY_INSTANCE=staging
GATEWAY_PUBLIC_URL=http://127.0.0.1:8099
# Tidak dibaca kode aplikasi (hanya docker-compose). Diisi agar dokumentatif.
WEBHOOK_TARGET=http://127.0.0.1:3200/api/webhook/evolution
WEBHOOK_TOKEN=<isi>

# ---------------------------------------------------------------- identitas akun sendiri
# Sama dengan .env: bukan rahasia, dan ikut menentukan kebenaran deteksi
# pesan-sendiri saat parsing.
WA_SELF_PN=6281234567890
WA_SELF_LID=123456789012345

# ---------------------------------------------------------------- Fase 0
# WAJIB off. src/lib/rawdump.ts menulis ke process.cwd()/var/raw - folder yang
# SAMA dengan environment kerja lokal. Kalau on, staging mencemari dump
# percakapan klien yang nyata.
FASE0_DUMP=off

# ---------------------------------------------------------------- cron
CRON_TOKEN=<isi>

# ---------------------------------------------------------------- akses
ACCESS_PROXY_HOPS=0
ACCESS_IP_ALLOWLIST=

# ---------------------------------------------------------------- seed
SEED_PASSWORD=staging123

# ---------------------------------------------------------------- detak internal
# Nyala, supaya perilaku staging sama dengan production: outbox terlempar
# sendiri 10 detik sekali tanpa perlu memanggil /api/cron/tick.
# Ini aman HANYA karena GATEWAY_URL menunjuk gateway tiruan. Kalau suatu saat
# GATEWAY_URL diarahkan ke instance WhatsApp yang asli, kembalikan ini ke off
# dulu - kalau tidak, detak berikutnya mengirim pesan sungguhan tanpa ditanya.
INTERNAL_TICKER=on

# ---------------------------------------------------------------- build
# Folder build sendiri. Tanpa ini, `npm run dev` (3100) dan
# `npm run staging:dev` (3200) berebut .next/ dan saling merusak manifest.
NEXT_DIST_DIR=.next-staging

# ---------------------------------------------------------------------------
# Buat nilai acak untuk STAGING_POSTGRES_PASSWORD / AUTH_SECRET / WEBHOOK_TOKEN
# / CRON_TOKEN dengan:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# AUTH_SECRET wajib minimal 32 karakter (src/lib/auth.ts akan throw kalau
# kurang). Sandi di STAGING_POSTGRES_PASSWORD harus sama dengan yang tertulis
# di dalam DATABASE_URL - keduanya tidak dibaca dari satu sumber.
#
# WEBHOOK_TOKEN dipakai dua arah: app memeriksanya di /api/webhook/evolution,
# dan gateway tiruan mengirimkannya lewat header x-webhook-token.
# ---------------------------------------------------------------------------
